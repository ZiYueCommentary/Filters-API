    "authors": [ "ZiYueCommentary" ],
    "contact": {
        "homepage": "https://modrinth.com/project/filters-api",
        "sources": "https://github.com/ZiYueCommentary/Filters-API",
        "issues": "https://github.com/ZiYueCommentary/Filters-API/issues"
    },
